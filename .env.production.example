# Use this with -f compose.production.yaml alone, never merge compose.yaml.
COMPOSE_PROJECT_NAME=autoscholar-prod
PROD_PORT=8080
PROD_SECRETS_DIR=./data/deployment/secrets
AUTOSCHOLAR_API_IMAGE=autoscholar-api:prod-local
AUTOSCHOLAR_WEB_IMAGE=autoscholar-web:prod-local
AUTOSCHOLAR_REVISION=working-tree
# scripts/build_production.py supplies the current lock hash.
AUTOSCHOLAR_LOCK_SHA256=96e74b9ba2315dc49cf664f256ad8d1e6b1d61bdd9d9043f5e271378642f9d8c
API_ALLOWED_HOSTS=["localhost","127.0.0.1"]
API_ALLOWED_ORIGINS=[]
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Set a mounted path only after filling that local provider file.
LLM_API_KEY_FILE=
EMBEDDING_API_KEY_FILE=
TAVILY_API_KEY_FILE=
SEMANTIC_SCHOLAR_API_KEY_FILE=
WORKFLOW_APPROVAL_THRESHOLD=20000
