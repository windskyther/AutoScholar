APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://autoscholar:autoscholar@localhost:5432/autoscholar
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=autoscholar_chunks_v1

# OpenAI-compatible endpoint. Keep real credentials in .env only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Phase 2 research providers. Keep real credentials in .env only.
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
RESEARCH_TIMEOUT_SECONDS=20
RESEARCH_CACHE_TTL_SECONDS=86400

# Phase 3 knowledge base. Local FastEmbed is the default and needs no API key.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=384
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-base
MODEL_CACHE_PATH=data/models

DOCUMENT_STORAGE_PATH=data/documents
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_MAX_PAGES=500
DOCUMENT_PARSE_TIMEOUT_SECONDS=120
RAG_CHUNK_TOKENS=96
RAG_CHUNK_OVERLAP=16
RAG_TOP_K=8
RAG_CANDIDATE_LIMIT=30
RAG_WORKER_POLL_SECONDS=2
RAG_JOB_LEASE_SECONDS=600
RAG_JOB_MAX_ATTEMPTS=3

# Phase 4 task workspaces and isolated execution. No secret is passed to the sandbox.
WORKSPACE_ROOT=data/workspaces
WORKSPACE_MAX_FILES=100
WORKSPACE_MAX_FILE_BYTES=1048576
WORKSPACE_MAX_SOURCE_BYTES=10485760
SANDBOX_MANAGER_URL=http://sandbox-manager:8090
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_REPAIRS=3
