APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# JSON arrays. Production requires exact hosts instead of '*'.
API_ALLOWED_HOSTS=["*"]
API_ALLOWED_ORIGINS=[]
# Shared request governance. Full category defaults and retry rules: docs/security/governance.md
API_REQUEST_LIMITS=null
API_JSON_MAX_BYTES=1048576
API_MULTIPART_OVERHEAD_BYTES=1048576
API_RESPONSE_MAX_BYTES=8388608
API_BODY_TIMEOUT_SECONDS=120
API_BODY_IDLE_SECONDS=15
API_SEND_TIMEOUT_SECONDS=15
API_SSE_IDLE_SECONDS=45
API_LEASE_SECONDS=30
API_CONTROL_TIMEOUT_SECONDS=3

DATABASE_URL=postgresql+asyncpg://autoscholar:autoscholar@localhost:5432/autoscholar
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=autoscholar_chunks_v1

# OpenAI-compatible endpoint. Keep real credentials in .env only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180
# auto detects api.deepseek.com only; use deepseek for an explicitly compatible gateway.
# generic preserves the standard OpenAI-compatible request format.
LLM_COMPATIBILITY_PROFILE=auto

# Phase 2 research providers. Keep real credentials in .env only.
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
RESEARCH_TIMEOUT_SECONDS=20
RESEARCH_CACHE_TTL_SECONDS=86400

# Phase 3 knowledge base. Local FastEmbed is the default and needs no API key.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=384
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-base
MODEL_CACHE_PATH=data/models

DOCUMENT_STORAGE_PATH=data/documents
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_MAX_PAGES=500
DOCUMENT_PARSE_TIMEOUT_SECONDS=120
RAG_CHUNK_TOKENS=96
RAG_CHUNK_OVERLAP=16
RAG_TOP_K=8
RAG_CANDIDATE_LIMIT=30
RAG_WORKER_POLL_SECONDS=2
RAG_JOB_LEASE_SECONDS=600
RAG_JOB_MAX_ATTEMPTS=3

# Phase 4 task workspaces and isolated execution. No secret is passed to the sandbox.
WORKSPACE_ROOT=data/workspaces
WORKSPACE_MAX_FILES=100
WORKSPACE_MAX_FILE_BYTES=1048576
WORKSPACE_MAX_SOURCE_BYTES=10485760
SANDBOX_MANAGER_URL=http://sandbox-manager:8090
# Separate random 32+ character internal credential. Never reuse the API or MCP token.
SANDBOX_MANAGER_TOKEN=
SANDBOX_MANAGER_TOKEN_FILE=
SANDBOX_MANAGER_MAX_CONCURRENT=2
SANDBOX_MANAGER_MAX_BODY_BYTES=16777216
SANDBOX_ALLOWED_ACTIONS=["static_check","run_python","run_pytest","run_shell"]
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_REPAIRS=3

# Phase 5 experiment artifact limits. Keep experiment data outside Git.
WORKSPACE_MAX_ARTIFACT_FILES=100
WORKSPACE_MAX_ARTIFACT_FILE_BYTES=16777216
WORKSPACE_MAX_ARTIFACT_BYTES=67108864
SANDBOX_MAX_ARTIFACT_FILE_BYTES=16777216
SANDBOX_MAX_ARTIFACT_BYTES=67108864
EXPERIMENT_TIMEOUT_SECONDS=600
# Required for experiment execution and Artifact access. Use a long random secret.
EXPERIMENT_API_TOKEN=
# All business API routes now require this token, including /chat and /projects.
# Alternatively mount a UTF-8 secret file; leave the direct value empty.
EXPERIMENT_API_TOKEN_FILE=
LLM_API_KEY_FILE=
EMBEDDING_API_KEY_FILE=
TAVILY_API_KEY_FILE=
SEMANTIC_SCHOLAR_API_KEY_FILE=
QDRANT_API_KEY_FILE=
MCP_SERVICE_TOKEN_FILE=

# Phase 6 server budget ceilings as JSON; request-level budgets can only lower these.
AUTONOMOUS_BUDGET={}
WORKFLOW_WORKER_POLL_SECONDS=2
WORKFLOW_JOB_LEASE_SECONDS=30
# Epochs * training samples * number of models; 0 requires approval for every experiment.
WORKFLOW_APPROVAL_THRESHOLD=20000

# Phase 8: native is the explicit compatibility mode; compose.mcp.yaml selects mcp.
RESEARCH_TOOL_BACKEND=native
FILESYSTEM_TOOL_BACKEND=native
GIT_TOOL_BACKEND=disabled
EXPERIMENT_TOOL_BACKEND=native
MCP_EXPERIMENT_URL=http://experiment-mcp:8094/mcp
MCP_ARTIFACT_ROOT=data/mcp-artifacts
MCP_GIT_URL=http://git-mcp:8093/mcp
# Exact public HTTPS repository allowlist, JSON array; empty disables clone access.
MCP_GIT_ALLOWED_URLS=[]
MCP_FILESYSTEM_URL=http://filesystem-mcp:8092/mcp
MCP_RESEARCH_URL=http://research-mcp:8091/mcp
MCP_SERVICE_TOKEN=
MCP_TIMEOUT_SECONDS=25
# Optional Research MCP-only database URL; prefer a dedicated read-only account.
MCP_DOCUMENT_DATABASE_URL=
