{
  "schema_version": 1,
  "suite_id": "rag-public-v1",
  "description": "Fixed ranking replay, not an implementation of Dense, BM25, Hybrid or reranking. Balanced artificial rank positions avoid implying any algorithm is better. Repeated IDs deliberately exercise duplicate handling.",
  "chunks": [
    {
      "id": "mnist-subset",
      "document_id": "public-mnist",
      "text": "The CPU acceptance experiment uses 2048 training samples and 1024 test samples."
    },
    {
      "id": "mnist-epochs",
      "document_id": "public-mnist",
      "text": "The small MNIST acceptance comparison trains for two epochs."
    },
    {
      "id": "mnist-seed",
      "document_id": "public-mnist",
      "text": "The acceptance specification fixes the random seed to 42."
    },
    {
      "id": "mnist-batch",
      "document_id": "public-mnist",
      "text": "The acceptance specification uses batch size 64."
    },
    {
      "id": "mnist-comparison",
      "document_id": "public-mnist",
      "text": "The experiment compares an MLP with a CNN; a lower CNN accuracy is not itself an engineering failure."
    },
    {
      "id": "sandbox-network",
      "document_id": "public-sandbox",
      "text": "Experiment code runs in a Docker sandbox with networking disabled."
    },
    {
      "id": "sandbox-secrets",
      "document_id": "public-sandbox",
      "text": "LLM and search credentials are not provided to the training sandbox."
    },
    {
      "id": "sandbox-timeout",
      "document_id": "public-sandbox",
      "text": "A sandbox timeout ends the execution and records a timeout outcome instead of waiting indefinitely."
    },
    {
      "id": "sandbox-source",
      "document_id": "public-sandbox",
      "text": "Compare the source snapshot SHA-256 with the registered source digest before trusting the experiment."
    },
    {
      "id": "sandbox-artifacts",
      "document_id": "public-sandbox",
      "text": "Verify both the registered byte length and SHA-256 of an artifact before exporting it."
    },
    {
      "id": "workflow-approval",
      "document_id": "public-workflow",
      "text": "Approval leaves a task paused. Resuming it requires a separate explicit control action."
    },
    {
      "id": "workflow-idempotency",
      "document_id": "public-workflow",
      "text": "Confirm the original submission using the same idempotency identifier; do not submit a new identifier blindly."
    },
    {
      "id": "workflow-budget",
      "document_id": "public-workflow",
      "text": "An autonomous root task and its children share one budget; summing both would double count usage."
    },
    {
      "id": "workflow-events",
      "document_id": "public-workflow",
      "text": "Resume persisted task events after the last delivered sequence using Last-Event-ID."
    },
    {
      "id": "workflow-memory",
      "document_id": "public-workflow",
      "text": "Experience memory is project-scoped and must retain verifiable task and review provenance."
    },
    {
      "id": "retrieval-dense",
      "document_id": "public-retrieval",
      "text": "Dense retrieval compares dense embedding vectors for queries and stored chunks."
    },
    {
      "id": "retrieval-sparse",
      "document_id": "public-retrieval",
      "text": "The configured sparse provider uses the Qdrant/bm25 model."
    },
    {
      "id": "retrieval-hybrid",
      "document_id": "public-retrieval",
      "text": "Hybrid retrieval combines dense and sparse retrieval rankings."
    },
    {
      "id": "retrieval-reranker",
      "document_id": "public-retrieval",
      "text": "A reranker reorders an existing candidate set before returning the selected results."
    },
    {
      "id": "retrieval-citation",
      "document_id": "public-retrieval",
      "text": "PDF evidence preserves document and chunk identifiers, with page and section information where available."
    }
  ],
